{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDirs": [
      "..",
      "svelte"
    ],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "tsbuildinfo.json"
  },
  "files": [
    "../node_modules/svelte-check/dist/src/svelte-shims-v4.d.ts",
    "../node_modules/svelte/svelte-html.d.ts"
  ],
  "include": [
    "../src/**/*.ts",
    "../src/**/*.svelte",
    "svelte/src/**/*.ts",
    "svelte/src/**/*.d.svelte.ts"
  ],
  "exclude": [
    "../src/App.svelte"
  ]
}